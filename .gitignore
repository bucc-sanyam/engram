# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/*.pdf

# NCERT reference PDFs — copyrighted, never commit.
# The trailing slash misses a symlink to them, which is how a worktree gets at
# the originals, so match both.
.claude/Books/
.claude/Books

# Figure render output — build artefacts, never committed
# (scripts/render-figures.mts, scripts/extract-book-figures.py --contact)
.figures/
.figures-contact.png
